# Copie para .env (lido automaticamente ao rodar da raiz do projeto).

# Senha do JWT. PRECISA ser o mesmo valor do monólito: é o que faz o token emitido
# aqui ser aceito lá. Gere com: openssl rand -base64 48
NEXO_JWT_SECRET=

# Banco (mesmos valores do docker-compose.yml). A porta 5436 é a que o compose publica no
# host (DB_HOST_PORT); só vale para rodar a API fora do Docker com ./mvnw spring-boot:run.
DB_URL=jdbc:postgresql://localhost:5436/usuario_db
DB_USER=nexo_admin
DB_PASSWORD=

NEXO_SEED_ENABLED=true

# PEDAGOGICO_ENABLED=false desliga a validação.
PEDAGOGICO_URL=http://localhost:8080
PEDAGOGICO_ENABLED=true

CORS_ALLOWED_ORIGINS=http://localhost:4200
